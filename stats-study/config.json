{
    "$schema": "https://raw.githubusercontent.com/revisit-studies/study/main/src/parser/StudyConfigSchema.json",
    "studyMetadata": {
        "title": "Stats Study",
        "version": "pilot",
        "authors": [
            "The reVISit Team"
        ],
        "date": "2024-03-19",
        "description": "A simple stats study",
        "organizations": ["WPI"]
    },
    "uiConfig": {
        "contactEmail": "contact@revisit.dev",
        "helpTextPath": "stats-study/assets/help.md",
        "logoPath": "revisitAssets/revisitLogoSquare.svg",
        "withProgressBar": true,
        "autoDownloadStudy": false,
        "sidebar": true
    },
    "components": {
        "introduction": {
            "type": "markdown",
            "path": "stats-study/assets/introduction.md",
            "response": []
        },

        "linked-view": {
            "type": "react-component",
            "instruction": "You can add the data, and see basic statistics and distribution.",
            "description": "Basic statistics",
            "instructionLocation": "sidebar",
            "path": "statisvis/assets/LinkedGraph.jsx",
            "recordAudio": true,
            "response": []
        },
        
        "correlation": {
            "type": "react-component",
            "instruction": "Explore correlation: adjust the relationship strength, add points, and observe how the Pearson correlation coefficient changes.",
            "instructionLocation": "sidebar",
            "path": "statisvis/assets/CorrelationExplorer.jsx",
            "recordAudio": true,
            "response": []
        },
        "linear-regression": {
            "type": "react-component",
            "description": "Linear regression",
            "instruction": "Learn linear regression: add points, view the best-fit line, see residuals, and explore predictions step by step.",
            "instructionLocation": "sidebar",
            "path": "statisvis/assets/LinearReg.jsx",
            "recordAudio": true,
            "response": []
        },
       
        "sampling-distribution": {
            "type": "react-component",
            "description": "Central Limit Theorm",
            "instruction": "- This interactive demo illustrates the Central Limit Throrem: Regardless of the population shape, the distribution of sample means tends to be normal as the number of samples increase.\n - Select a population shape, sample size and number of samples. Then click Simulate button to see how the distributon of sample means forms.",
            "instructionLocation": "sidebar",
            "recordAudio": true,
            "path": "statisvis/assets/SamplingSimulator.jsx",
            "response": []
        }
    },
    "sequence": {
        "order": "fixed",
        "components": [
            "introduction",
            "linked-view",
            "correlation",
            "linear-regression",
            "sampling-distribution"
        ]
    }
}